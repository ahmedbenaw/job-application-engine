{
  "skill": {
    "name": "job-application-engine",
    "version": "2.2.0",
    "edition": "generic-universal",
    "author": "Ahmed Ossama | Product Leader, Builder & Venture Management Architect",
    "external_dependencies": "none",
    "design_record": "docs/CV_ATS_REQUIREMENTS_SPEC_v0.11.0.md"
  },
  "scoring": {
    "passing_threshold": 5,
    "scale": "1 to 5",
    "below_threshold_action": "rerun_current_phase",
    "review_format": [
      "what_was_correct",
      "score_1_to_5",
      "expected_for_perfect_result"
    ],
    "v2_2_model": {
      "mandatory_gates": {
        "M1": {
          "after": "phase_1",
          "covers": [
            "phase_1"
          ]
        },
        "M2": {
          "after": "phase_2",
          "covers": [
            "phase_2_step_2a",
            "phase_2"
          ]
        },
        "M3": {
          "after": "phase_3",
          "covers": [
            "phase_3"
          ]
        },
        "M4": {
          "after": "phase_3b",
          "covers": [
            "phase_3b"
          ]
        },
        "M5": {
          "after": "phase_5",
          "covers": [
            "phase_4",
            "phase_5"
          ]
        }
      },
      "setup_signoff": {
        "when": "first_use_step_3",
        "frequency": "once_per_person",
        "counted_in_mandatory": false
      },
      "mandatory_required_score": 5,
      "complementary_phases": [
        "phase_0",
        "phase_2_step_2a",
        "phase_3b_critique",
        "phase_3c",
        "phase_6",
        "phase_7"
      ],
      "complementary_auto_score": {
        "5": "all_checks_pass",
        "4": "should_level_issues_only",
        "3": "three_or_more_waivers_or_warnings",
        "1_2": "a_must_check_failed"
      },
      "complementary_user_score": "optional_any_time_before_next_mandatory_gate_with_one_line_note",
      "escalation": {
        "auto_score_at_or_below": 3,
        "user_score_below": 5,
        "effect": "phase_becomes_blocking_5_of_5_gate"
      },
      "visible_grade_line": "print_on_phase_finish_and_repeat_at_next_mandatory_gate",
      "scores_never_authorise_actions": true,
      "log_all_scores": "application_log"
    }
  },
  "job_level_framework": {
    "levels": [
      {
        "id": 0,
        "name": "Novice",
        "titles": [
          "Intern"
        ],
        "salary_percentile": "floor"
      },
      {
        "id": 1,
        "name": "Entry",
        "titles": [
          "Junior",
          "Associate",
          "Graduate"
        ],
        "salary_percentile": "floor_to_midpoint"
      },
      {
        "id": 2,
        "name": "Mid",
        "titles": [
          "[Role]",
          "Associate with full responsibility"
        ],
        "salary_percentile": "floor_to_midpoint"
      },
      {
        "id": 3,
        "name": "Senior",
        "titles": [
          "Senior",
          "Team Lead",
          "Staff"
        ],
        "salary_percentile": "midpoint_to_75th"
      },
      {
        "id": 4,
        "name": "Manager",
        "titles": [
          "Manager",
          "Principal",
          "Group Lead"
        ],
        "salary_percentile": "midpoint_to_75th"
      },
      {
        "id": 5,
        "name": "Director",
        "titles": [
          "Director",
          "Senior Director"
        ],
        "salary_percentile": "75th_to_stretch"
      },
      {
        "id": 6,
        "name": "Head_VP",
        "titles": [
          "Head of",
          "VP",
          "Vice President"
        ],
        "salary_percentile": "75th_to_stretch"
      },
      {
        "id": 7,
        "name": "Executive",
        "titles": [
          "C-Suite",
          "CPO",
          "CTO",
          "CEO",
          "MD",
          "President"
        ],
        "salary_percentile": "stretch_custom_negotiation"
      }
    ],
    "startup_calibration": "subtract_one_level_from_title_at_companies_under_50_people",
    "detection_rule": "read_scope_and_responsibilities_not_title_alone"
  },
  "workflow": {
    "phase_count": 8,
    "first_use": {
      "trigger": "no_profile_exists_or_user_requests_rebuild",
      "steps": [
        {
          "step": 0,
          "name": "Document and Link Detection",
          "description": "Always runs first before any questions are asked",
          "actions": [
            "scan_session_for_uploaded_files_pdf_docx_text",
            "scan_opening_message_for_urls_linkedin_github_portfolio",
            "fetch_each_url_with_web_fetch",
            "extract_profile_fields_from_each_source",
            "build_preliminary_field_map_extracted_partial_not_found"
          ],
          "extraction_sources": {
            "cv_resume": [
              "name",
              "email",
              "phone",
              "linkedin",
              "portfolio",
              "location",
              "education",
              "certifications",
              "work_history_to_key_evidence",
              "tools_to_tools_stack",
              "languages"
            ],
            "linkedin_url": [
              "name",
              "headline_to_positioning",
              "experience_to_key_evidence",
              "education",
              "skills_to_tools_stack",
              "certifications",
              "contact"
            ],
            "github_url": [
              "repos",
              "languages",
              "projects_to_portfolio_assets",
              "tools_to_tools_stack"
            ],
            "portfolio_url": [
              "bio_to_positioning",
              "projects_to_key_evidence",
              "contact"
            ],
            "inline_text": "extract_any_usable_data_point_from_opening_message"
          }
        },
        {
          "step": 1,
          "name": "Present Extraction Results",
          "description": "Show what was found for confirmation. Skip if no sources provided.",
          "format": "extracted_confirmed_partial_notfound_sections",
          "user_action": "CONFIRM or list corrections"
        },
        {
          "step": 2,
          "name": "Gap-Fill Questions",
          "description": "Ask only for fields not extracted or not confirmed. Never re-ask confirmed fields.",
          "fields": "static_fields_dynamic_fields_compensation_fields",
          "minimum_questions": 0,
          "maximum_questions": 25
        },
        {
          "step": 3,
          "name": "Profile Confirmation and Sign-Off",
          "description": "Present complete profile. Apply scoring gate (5 required). Write to profile file on score 5.",
          "scoring_gate": true,
          "required_score": 5,
          "output_file": "references/applicant-profile-template.md"
        },
        {
          "step": 4,
          "name": "Returning Session Staleness Check",
          "description": "For existing profiles only. Checks time-sensitive fields at every session start.",
          "stale_fields": {
            "availability": "re_confirm_every_session_do_not_use_value_older_than_2_weeks",
            "salary_anchors": "flag_if_source_date_older_than_6_months",
            "active_engagement": "confirm_still_active_and_end_date_unchanged"
          }
        },
        {
          "step": 5,
          "name": "Per-Application Profile Update Protocol",
          "description": "Runs during workflow at Phase 3 and Phase 7. Keeps profile current across applications.",
          "triggers": {
            "after_phase_3": [
              "portfolio_url_updated",
              "new_salary_market_confirmed",
              "availability_changed",
              "language_level_updated",
              "new_tool_added"
            ],
            "after_phase_7_branch_a": "log_submitted_update_salary_anchors_if_offer",
            "after_phase_7_branch_b": "log_withdrawn_with_reason_flag_recurring_gap_patterns",
            "after_phase_7_branch_c": "log_rejected_identify_gap_source_suggest_profile_adjustment",
            "mid_session_document_upload": "run_step_0_extraction_on_new_source_surface_diffs"
          },
          "consent_required": "APPROVE_UPDATE_tier_2_before_writing_any_change"
        }
      ],
      "v2_2_step_2_questionnaire": "references/intake-questionnaire.md"
    },
    "session_entry_gate": {
      "runs_after": "A0_capability_detection",
      "runs_before": "phase_0_or_phase_1",
      "purpose": "detect_session_mode_and_route_accordingly",
      "mode_a": {
        "name": "Job Discovery",
        "trigger_signals": [
          "no_file_uploaded_and_no_job_url_provided",
          "user_says_find_me_jobs_or_search_for_roles",
          "user_describes_general_target_role_sector_city",
          "post_submission_branch_a_continuation"
        ],
        "entry_phase": 0,
        "cold_start_prompt": "ask_role_type_seniority_sector_geography_if_no_anchor"
      },
      "mode_b": {
        "name": "Direct Application",
        "trigger_signals": [
          "file_uploaded_cv_resume_pdf_docx",
          "job_url_pasted_or_detected_in_message",
          "user_says_apply_for_this_or_I_want_to_apply_to",
          "jd_text_pasted_directly",
          "company_name_plus_role_title_in_opening_message"
        ],
        "entry_phase": 1,
        "skip_phase_0": true,
        "phase_0_checklist_status": "Skipped_Mode_B",
        "parallel_intake": {
          "a": "feed_cv_to_first_use_step_0_extraction",
          "b": "feed_job_url_to_phase_1_company_intelligence"
        }
      },
      "ambiguous_signal": "present_mode_selection_prompt_to_user",
      "mode_b_intake": {
        "required": [
          "cv_or_resume_uploaded_or_pasted",
          "job_url_or_jd_text"
        ],
        "prompt_if_missing": "ask_specifically_for_whichever_is_absent"
      }
    },
    "phases": [
      {
        "id": 0,
        "name": "Job Discovery",
        "mode": "mode_a_only",
        "trigger": "session_entry_gate_routes_mode_a",
        "cold_start": "prompt_for_role_type_seniority_sector_geography_if_no_anchor_mode_a_only",
        "read_profile_fields": [
          "TARGET_ROLE_TYPES",
          "TARGET_SENIORITY_LEVEL",
          "TARGET_SECTORS",
          "PREFERRED_CITIES",
          "HARD_EXCLUSION_GEOGRAPHIES"
        ],
        "platforms": [
          "LinkedIn",
          "Indeed",
          "Wellfound",
          "Relocate.me",
          "EuroTechJobs",
          "Greenhouse",
          "Lever",
          "BreezyHR",
          "WelcomeToTheJungle",
          "RemoteOK"
        ],
        "search_passes": 2,
        "output_columns": [
          "Rank",
          "Company",
          "Role",
          "Level",
          "Location",
          "Relocation",
          "Fit Signal",
          "URL"
        ],
        "rank_by": [
          "relocation_offered",
          "level_match",
          "role_title_match",
          "sector_alignment"
        ],
        "cap": 20,
        "flag_top": 5,
        "scoring_gate": "complementary",
        "required_score": "5_only_if_escalated"
      },
      {
        "id": 1,
        "name": "Company Intelligence",
        "trigger": "user_selects_role_or_provides_url",
        "operations_parallel": [
          "fetch_job_posting",
          "fetch_application_form",
          "identify_hiring_manager",
          "research_company_and_product"
        ],
        "form_fetch": {
          "breezy_hr": "append_slash_apply_flag_template_variables",
          "greenhouse": "embed_url_or_append_flag_custom_questions",
          "lever": "append_slash_apply",
          "linkedin": "flag_paste_manually",
          "indeed": "flag_paste_manually",
          "fallback": "flag_all_template_variables_to_user"
        },
        "output": "company_intelligence_brief",
        "scoring_gate": true,
        "required_score": 5,
        "gate": "M1"
      },
      {
        "id": 2,
        "name": "Fit Analysis",
        "trigger": "phase_1_score_5",
        "gate": "M2",
        "steps": [
          "detect_role_level_from_jd_scope",
          "compare_detected_level_to_profile_target",
          "extract_mandatory_and_preferred_requirements",
          "two_column_evidence_mapping",
          "compensating_evidence_mapping",
          "verdict_assignment",
          "session_gap_statement_to_log_only"
        ],
        "verdicts": {
          "clean_fit": "all_mandatory_covered",
          "honest_stretch": "one_or_two_mandatory_gaps_with_compensating_evidence",
          "mismatch": "two_or_more_mandatory_gaps_no_compensation_halt"
        },
        "mismatch_action": "halt_inform_user_do_not_produce",
        "scoring_gate": true,
        "required_score": 5,
        "gap_log": "start_in_phase_2_REQ-39",
        "step_2a": {
          "name": "Job Analysis",
          "actions": [
            "number_requirements_must_or_nice",
            "build_locked_keyword_list_exact_wording_weighted_with_variants",
            "link_each_keyword_to_requirement_number",
            "detect_role_level",
            "compare_with_track_base_keywords"
          ],
          "score": "complementary",
          "shared_list_with_fit": "INT-06"
        }
      },
      {
        "id": 3,
        "name": "Clarifying Intake",
        "trigger": "phase_2_score_5",
        "presentation": "single_block_no_dripping",
        "critical_gates": [
          "portfolio_url",
          "salary_anchor_or_research",
          "availability",
          "relocation",
          "custom_questions"
        ],
        "important_gates": [
          "specific_project",
          "language_level",
          "product_trial_observation"
        ],
        "salary_research": {
          "year": "current_year_dynamic",
          "sources": [
            "Glassdoor",
            "Handpicked",
            "Levels.fyi"
          ],
          "level_adjustment": "apply_level_to_percentile_mapping",
          "output": "floor_target_stretch_gross_plus_net",
          "form_entry": "single_gross_figure",
          "fractional": "annual_div_220_times_1.4",
          "multi_currency": "store_separately_flag_exchange_risk_do_not_convert"
        },
        "scoring_gate": true,
        "required_score": 5,
        "gate": "M3",
        "v2_2_adds": [
          "knockout_criteria",
          "country_profile",
          "positioning_source",
          "prefill_from_profile_confirm_only"
        ]
      },
      {
        "id": 4,
        "name": "Application Package",
        "trigger": "all_critical_gates_phase_3_cleared",
        "deliverables": [
          "standard_form_fields",
          "experience_summary",
          "cover_letter",
          "custom_question_answers"
        ],
        "cover_letter": {
          "templates": "references/cover-letter-templates.md",
          "address_to": "named_person_from_phase_1_title_fallback_never_to_whom_it_may_concern",
          "structure": [
            "opening_why_role_why_company",
            "evidence_company_tool_metric",
            "product_observation",
            "gap_acknowledgment_if_stretch",
            "strong_action_close"
          ],
          "prohibited_closes": [
            "I look forward to your reply",
            "Please call me at your earliest convenience"
          ],
          "word_limits": {
            "text_box": 450,
            "online_email": 250,
            "document": 500
          },
          "level_tone": {
            "0_to_2": "enthusiastic_learning_focused",
            "3_to_4": "direct_delivery_focused",
            "5_to_7": "strategic_organisational_outcome_at_scale"
          }
        },
        "route_through": "phase_5",
        "scoring_gate": true,
        "required_score": 5,
        "v2_2_adds": [
          "requires_ats_gate_pass",
          "summary_derived_from_cv_GAP-12",
          "gap_lines_from_gap_log"
        ]
      },
      {
        "id": 5,
        "name": "Writing Quality Pass",
        "trigger": "phase_4_output_ready",
        "passes": 2,
        "present": "final_only_never_draft",
        "pattern_families": [
          "significance_inflation",
          "promotional_language",
          "structural_ai_patterns",
          "voice_and_attribution",
          "technical_ai_tells"
        ],
        "pass_2_audit": "ask_what_still_makes_this_ai_generated_then_fix",
        "scoring_gate": true,
        "required_score": 5,
        "gate": "M5",
        "v2_2_adds": [
          "protected_locked_keywords_INT-03"
        ]
      },
      {
        "id": 6,
        "name": "Governance Gate",
        "trigger": "phase_5_score_5",
        "checks": [
          "third_party_completable_without_questions",
          "all_claims_traceable_to_profile_or_phase_3",
          "salary_single_gross_figure_correct_currency",
          "gap_acknowledged_in_cover_letter_and_why_suitable",
          "all_placeholder_tokens_resolved_or_flagged",
          "cover_letter_within_word_limit",
          "portfolio_field_is_valid_url",
          "salary_field_is_numeric_not_prose"
        ],
        "failure_action": "fix_before_presenting",
        "scoring_gate": "complementary",
        "required_score": "5_only_if_escalated",
        "v2_2_adds": [
          "check_9_ats_gate_pass",
          "public_profile_consistency",
          "gap_log_handled",
          "combined_report"
        ]
      },
      {
        "id": 7,
        "name": "Post-Submission Loop",
        "trigger": "user_confirms_submission_withdrawal_or_rejection",
        "branches": {
          "a_submission": "anchor_on_submitted_role_return_to_phase_0_present_next_5",
          "b_withdrawal": "log_withdrawn_ask_reason_refine_next_discovery",
          "c_rejection": "log_outcome_identify_gap_ask_recalibration_preference"
        },
        "post_session": [
          "update_excluded_companies_log",
          "update_salary_anchors_if_offer_data"
        ],
        "scoring_gate": "complementary",
        "required_score": "5_only_if_escalated",
        "v2_2_adds": [
          "application_log_GAP-13",
          "follow_up_window_7_14_21_days_max_21",
          "interview_prep_when_booked_GAP-14"
        ]
      }
    ],
    "v2_2_phase_map": [
      "first_use",
      "phase_0",
      "phase_1",
      "phase_2_step_2a",
      "phase_2",
      "phase_3",
      "phase_3b",
      "phase_3c",
      "phase_4",
      "phase_5",
      "phase_6",
      "phase_7"
    ],
    "sub_phases": [
      {
        "id": "3B",
        "name": "CV Build",
        "after": 3,
        "before": 4,
        "steps": [
          "write_from_positioning_source",
          "critique_REQ-38",
          "style_pass_protected_terms"
        ],
        "gate": "M4",
        "then": "ask_APPROVE_CREATE_A17",
        "reference": "references/cv-build.md"
      },
      {
        "id": "3C",
        "name": "ATS Gate",
        "after": "3B",
        "before": 4,
        "checks": [
          "GATE-00_definition",
          "GATE-01_entry",
          "GATE-02_export",
          "GATE-03_layout_lint",
          "GATE-04_read_test",
          "GATE-18_visual_review",
          "GATE-05_locked_keyword_integrity",
          "GATE-06_coverage_cap",
          "GATE-07_evidence_trace",
          "GATE-08_knockout_alignment",
          "GATE-09_content_hygiene",
          "GATE-10_platform_profile",
          "GATE-11_country_profile",
          "GATE-12_skim_test",
          "GATE-13_report",
          "GATE-14_freeze_fingerprint",
          "GATE-15_fail_handling_retry_points",
          "GATE-16_evidence_pack",
          "GATE-17_learn_from_outcomes"
        ],
        "defaults": {
          "file_type": "DOCX_main_plus_PDF_if_two_files_allowed",
          "must_have_coverage_min": 0.9,
          "repeat_cap": 4,
          "repeat_target": 3,
          "max_mb_unknown_platform": 2,
          "text_readers_standard": 2,
          "text_readers_min": 1,
          "retries_normal": 1,
          "retries_major_max": 5,
          "retry_points_min": 2
        },
        "score": "complementary",
        "script": "scripts/ats_gate.py",
        "reference": "references/ats-gate.md"
      }
    ]
  },
  "invariants": [
    "never_produce_application_text_before_phase_3_critical_gates",
    "never_fabricate_metrics_or_tool_names",
    "never_suggest_salary_without_research",
    "never_recommend_hard_excluded_geographies",
    "never_present_writing_quality_draft",
    "never_hide_mismatch_verdict",
    "never_use_to_whom_it_may_concern",
    "never_use_passive_close",
    "always_address_cover_letter_to_named_person",
    "always_run_level_framework_before_salary_research",
    "always_update_excluded_companies_log_after_discovery",
    "always_update_salary_anchors_after_offer_data",
    "never_add_unproven_keyword",
    "never_change_locked_keyword",
    "never_upload_untested_cv_file",
    "never_print_private_fields_or_collect_government_ids",
    "never_let_score_authorise_action",
    "always_show_grade_with_reason_for_non_stopping_phases",
    "never_stop_on_missing_tool_before_fallback_ladder_never_lower_consent_tier"
  ],
  "execution_modes": {
    "default": "agent_supported",
    "docs": {
      "execution_modes": "docs/EXECUTION_MODES.md",
      "mandatory_exclusions": "docs/MANDATORY_EXCLUSIONS.md",
      "platform_capabilities": "docs/platform-capabilities.md"
    },
    "agent_supported": {
      "id": "agent_supported",
      "label": "Mode 1 — agent-supported",
      "applies_to": [
        "Claude.ai",
        "Claude_CoWork",
        "Manus"
      ],
      "description": "Default. Full A0 and Phases 0–7 with scoring gates and consent tiers; conservative orchestration."
    },
    "cowork_autonomous": {
      "id": "cowork_autonomous",
      "label": "Mode 2 — CoWork autonomous (opt-in)",
      "applies_to": [
        "Claude_CoWork"
      ],
      "governance_anchor": "agent_supported_phase_workflow_and_skill_rules",
      "must_follow_phases": true,
      "must_follow_skill_and_rules": true,
      "drift_triggers": [
        "phase_boundary_without_completed_gate",
        "conflict_with_invariants",
        "irreversible_action_without_tier2_or_tier3",
        "tool_output_inconsistent_with_stated_objective",
        "suspected_injection_or_untrusted_instruction"
      ],
      "on_drift": "reanchor_to_agent_supported_checkpoint_pause_and_reconcile",
      "irreversible_actions_policy": "tier2_tier3_unchanged_by_default",
      "opt_in_phrases_exact": [
        "JAE MODE: COWORK_AUTONOMOUS",
        "I opt in to JAE CoWork autonomous mode with phase governance"
      ],
      "opt_out_phrases_exact": [
        "JAE MODE: AGENT_SUPPORTED"
      ],
      "after_each_autonomous_chunk": [
        "A15",
        "A16"
      ],
      "related_automations": [
        "A14",
        "A15",
        "A16"
      ]
    }
  },
  "platform_notes": {
    "claude_ai": "sequential_all_phases_wait_for_scoring_gate_in_conversation_tools_mcp_per_host_policy",
