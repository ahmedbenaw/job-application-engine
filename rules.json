        "Playwright",
        "Gmail",
        "Outlook_MS365",
        "Google_Drive",
        "OneDrive",
        "Google_Calendar"
      ],
      "output": "capability_map_presented_to_user",
      "proceed_condition": "user_acknowledges_map"
    },
    "consent_tiers": {
      "tier_1": {
        "label": "Read-only",
        "examples": [
          "job_board_fetch",
          "form_parse",
          "company_research"
        ],
        "gate": "none_phase_scoring_gate_sufficient",
        "approval_required": false
      },
      "tier_2": {
        "label": "Reversible write",
        "examples": [
          "docx_creation",
          "drive_save",
          "calendar_event"
        ],
        "gate": "preview_then_APPROVE_ACTION_NAME",
        "approval_required": true,
        "approval_format": "APPROVE [ACTION_NAME]",
        "valid_responses": [
          "APPROVE CREATE",
          "APPROVE SAVE",
          "APPROVE CALENDAR",
          "APPROVE COCHUNK"
        ],
        "invalid_responses": [
          "yes",
          "ok",
          "5",
          "score_of_5",
          "any_paraphrase"
        ],
        "note": "approval_and_scoring_are_separate_systems_never_conflate"
      },
      "tier_3": {
        "label": "Irreversible write",
        "examples": [
          "application_submit",
          "email_send",
          "form_field_commit"
        ],
        "gate": "full_consent_gate_with_data_preview",
        "approval_required": true,
        "approval_format": "APPROVE [SPECIFIC_PHRASE]",
        "valid_responses": [
          "APPROVE SUBMIT",
          "APPROVE SEND",
          "APPROVE FILL"
        ],
        "invalid_responses": [
          "yes",
          "ok",
          "5",
          "score_of_5",
          "any_paraphrase"
        ],
        "cancel_responses": [
          "CANCEL",
          "anything_else"
        ],
        "note": "exact_match_required_never_execute_on_partial_match"
      }
    },
    "browser_automation": {
      "primary": "BrowserBase_MCP",
      "secondary": "Playwright_MCP",
