{
  "description": "job-application-engine v2.2.0 enforcement hooks: only the CV file that passed the ATS Gate can be uploaded, and any change to it cancels the PASS.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*([Uu]pload|file_upload|[Bb]ash).*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/job-application-engine/hooks/scripts/pre_upload_guard.py\"",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Bash|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/job-application-engine/hooks/scripts/post_change_stale.py\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}